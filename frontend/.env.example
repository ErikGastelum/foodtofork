# Copy this file to `.env` (which is git-ignored) and edit it.
#   cp .env.example .env

# Where the FastAPI backend lives. Local default is below; use the Render URL once Erik deploys.
VITE_API_URL=http://localhost:8000

# true  = use built-in mock data (works with no backend running)
# false = call the real backend from docs/API_CONTRACT.md
VITE_USE_MOCK=true
