# Copy this file to frontend/.env.local (git-ignored) and edit it:
#   cp .env.example .env.local
# Vite only exposes variables that start with VITE_.

# Backend URL. Local backend (default):
VITE_API_URL=http://localhost:8000
# Deployed backend (after Erik deploys to Render):
# VITE_API_URL=https://foodtofork-api.onrender.com

# Recipes: true  = built-in sample recipes (default, until Jacob's /match and /recipes/{id} are merged)
#          false = the real backend
VITE_MOCK_RECIPES=true
