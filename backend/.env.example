# Copy to backend/.env (git-ignored) and fill in:   cp .env.example .env
# Never commit the real .env: it holds the admin password.

# --- Admin account -------------------------------------------------------
# Created automatically when the server starts (if it doesn't exist yet).
# Changing these later does NOT change an existing admin's password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# --- Database --------------------------------------------------------------
# Leave unset locally: accounts go in backend/foodtofork.db (SQLite).
# Deployed (Vercel / Render): set this to a Postgres URL, e.g. Neon from the
# Vercel Marketplace. Files are wiped on every deploy, so SQLite won't survive.
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- CORS --------------------------------------------------------------------
# The deployed frontend's address (comma-separate several).
# FRONTEND_URL=https://foodtofork.vercel.app
